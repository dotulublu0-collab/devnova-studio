generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
model Order {
  id          String   @id
  type        String
  name        String
  contact     String
  description String
  price       Int
  status      String   @default("Новый")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
